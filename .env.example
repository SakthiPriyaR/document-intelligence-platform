# ---------------------------------------------------------------------------
# Copy this file to backend/.env (or set these as real environment variables
# on your deployment platform) and fill in real values. Never commit a real
# .env file with secrets to source control.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins, or "*" for any.
CORS_ORIGINS=*

# --- Database ---------------------------------------------------------------
# Default: local SQLite file, zero setup required.
DATABASE_URL=sqlite:///./document_intelligence.db
# Example for Postgres (e.g. Render/Railway managed Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- File handling -----------------------------------------------------------
MAX_PAGE_COUNT=3
MAX_FILE_SIZE_MB=15

# --- OCR ----------------------------------------------------------------------
OCR_DPI=150
# Only needed if tesseract is not on PATH:
# TESSERACT_CMD=/usr/bin/tesseract

# --- LLM / AI extraction ------------------------------------------------------
# Default provider is Google Gemini (free tier, no credit card required):
# get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash

# To use Anthropic Claude instead, set LLM_PROVIDER=anthropic and fill these in
# (requires a funded Anthropic Console account):
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

LLM_REQUEST_TIMEOUT_SECONDS=40
LLM_MAX_RETRIES=1

# --- Financial validation tolerance -------------------------------------------
VALIDATION_ABS_TOLERANCE=1.0
VALIDATION_REL_TOLERANCE=0.01
